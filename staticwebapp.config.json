{
  "platform": {
    "apiRuntime": "dotnet-isolated:8.0"
  },
  "routes": [
    {
      "route": "/api/*"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/*.{css,svg,js,png,gif,ico,jpg,jpeg}", "/assets/*", "/images/*"]
  },
  "responseOverrides": {
    "400": {
      "statusCode": 400
    }
  }
}
