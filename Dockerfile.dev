# Development Dockerfile for local development with live reload
FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package.json package-lock.json* yarn.lock* pnpm-lock.yaml* ./

# Install dependencies
RUN npm install

# Copy source code
COPY . .

# Expose port (Astro dev server default)
EXPOSE 4321

# Run dev server with host accessible from outside container
CMD ["npm", "run", "dev"]
